@model RLRentalApp.Models.HomeIndexVm

@{
    ViewData["Title"] = "Property Dashboard";
}

<div class="container py-4 property-dashboard">
    <h1 class="mb-3">Property Dashboard</h1>
    <p class="text-muted mb-4">Choose a property to track payment status, services, rent, and extra notes.</p>

    <section class="card border-secondary mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1">
                <h2 class="h6 mb-1">Google Drive connection</h2>
                <p class="text-muted mb-0">Uses your connected Google account to create a test folder and <code>connection-test.txt</code> file inside your configured Google Drive folder.</p>
            </div>
            <button class="btn btn-outline-secondary" type="button" id="testGoogleDriveBtn">Test Google Drive</button>
            <div id="googleDriveTestMsg" class="alert mb-0 d-none" role="status"></div>
        </div>
    </section>

    <div id="selectedPropertyHeader" class="alert alert-primary d-none"></div>

    <section id="propertySwitcherSection" class="card shadow-sm mb-3 d-none">
        <div class="card-body d-flex flex-wrap align-items-end gap-2">
            <div>
                <label for="propertySwitchSelect" class="form-label mb-1">Switch property</label>
                <select class="form-select" id="propertySwitchSelect">
                    @foreach (var property in Model.Properties)
                    {
                        <option value="@property.Id">@property.Name (@property.AddressLine1)</option>
                    }
                </select>
            </div>
            <button class="btn btn-outline-primary" type="button" id="switchPropertyBtn">Load property</button>
        </div>
    </section>

    <section id="propertyStatusCard" class="card shadow-sm mb-4 d-none">
        <div class="card-body">
            <h2 class="h4 mb-3">Current Status</h2>
            <dl class="row mb-0" id="statusDetails"></dl>
        </div>
    </section>

    <section id="propertyActionSection" class="d-none">
        <h2 class="h5">Next Steps</h2>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#didPayModal">Did they pay?</button>
            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#lateChargeModal">Late rent / interest</button>
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addServicesModal">Add services</button>
            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addRentModal">Add rent</button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#sendEmailModal">Send email</button>
            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#moreInfoModal">Any more info</button>
            <button class="btn btn-dark" id="viewStatementBtn" data-bs-toggle="modal" data-bs-target="#statementModal">View statement</button>
        </div>
    </section>
</div>

<div class="modal fade" id="propertyPickerModal" tabindex="-1" aria-labelledby="propertyPickerLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="propertyPickerLabel">Which property are you busy with now?</h2>
            </div>
            <div class="modal-body">
                @if (!Model.Properties.Any())
                {
                    <p class="mb-0">No properties were found in the database yet.</p>
                }
                else
                {
                    <label class="form-label" for="propertySelect">Property</label>
                    <select class="form-select" id="propertySelect">
                        <option value="">-- Select a property --</option>
                        @foreach (var property in Model.Properties)
                        {
                            <option value="@property.Id">@property.Name (@property.AddressLine1)</option>
                        }
                    </select>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="confirmPropertyBtn" disabled>Continue</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="lateChargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Late rent / interest</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Use this when the renter did not pay, or when you want to add a late-rent interest/letter charge without saving a new payment first.</p>
                <button class="btn btn-outline-warning mb-3" type="button" id="checkLateInterestBtn">Check if interest is needed</button>
                <div id="lateInterestCheckMsg" class="alert d-none"></div>
                <div class="mb-3">
                    <label class="form-label" for="lateChargeDateInput">Charge date</label>
                    <input class="form-control" type="date" id="lateChargeDateInput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="manualLateInterestAmountInput">Interest amount</label>
                    <input class="form-control" type="number" min="0" step="0.01" id="manualLateInterestAmountInput" />
                    <div class="form-text">The check button can estimate this from the current balance and days after the 4th. You can change it before saving.</div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="manualLateLetterFeeInput" />
                    <label class="form-check-label" for="manualLateLetterFeeInput">Add R200 late payment letter fee</label>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="manualLateChargeNotesInput">Description / notes</label>
                    <input class="form-control" id="manualLateChargeNotesInput" maxlength="300" value="Manual late rent interest" />
                </div>
                <button class="btn btn-warning" type="button" id="saveManualLateChargeBtn">Add late charges to statement</button>
                <div id="manualLateChargeMsg" class="alert mt-3 d-none"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="didPayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Did they pay?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Upload one bank statement PDF. The selected-property search uses the editable search text below. The all-renter check still uses each renter's saved database payment reference.</p>
                <div class="mb-3">
                    <label for="paymentDescriptionContains" class="form-label">Selected-property search text</label>
                    <input class="form-control" id="paymentDescriptionContains" placeholder="Defaults to the selected renter's saved payment reference" />
                    <div class="form-text">Only used by <strong>Search selected property only</strong>. Change this when this renter paid with a different reference.</div>
                </div>
                <div class="mb-3">
                    <label for="paymentPdfFile" class="form-label">Statement PDF</label>
                    <input class="form-control" type="file" id="paymentPdfFile" accept="application/pdf,.pdf" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-success" type="button" id="parseAllRentersPaymentPdfBtn">Check all renters in this PDF</button>
                    <button class="btn btn-primary" type="button" id="parsePaymentPdfBtn">Search selected property only</button>
                </div>

                <div id="paymentPdfError" class="alert alert-danger mt-3 d-none"></div>

                <div id="paymentResults" class="mt-3 d-none">
                    <h3 class="h6">Detected payments</h3>
                    <p class="small text-muted mb-2">All-renter mode uses each saved renter payment reference from the database. It warns when someone did not pay, paid less than rent, or paid rent but not services. You can remove any row before saving. Duplicate same amount on the same day is automatically blocked.</p>
                    <div id="renterPaymentSummary" class="mb-3 d-none"></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="paymentTableBody"></tbody>
                        </table>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="paymentNotesInput">Notes (optional)</label>
                        <input type="text" class="form-control" id="paymentNotesInput" maxlength="400" />
                    </div>
                    <button class="btn btn-success" type="button" id="savePaymentsBtn">Save payments</button>
                    <div id="savePaymentsMsg" class="alert mt-3 d-none"></div>

                    <details>
                        <summary>Raw text preview</summary>
                        <pre id="paymentPdfRawText" class="small mt-2 mb-0"></pre>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addServicesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Add services</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Upload the property services PDF and we will extract key values for Electricity, Water, Sewerage, and Refuse.</p>
                <div class="mb-3">
                    <label for="servicePdfFile" class="form-label">Services PDF</label>
                    <input class="form-control" type="file" id="servicePdfFile" accept="application/pdf,.pdf" />
                </div>
                <div class="mb-3">
                    <label for="servicePdfPassword" class="form-label">PDF password (if needed)</label>
                    <input class="form-control" type="password" id="servicePdfPassword" autocomplete="off" placeholder="Leave blank unless the PDF asks for a password" />
                    <div class="form-text">Some water/electricity PDFs are protected. Enter that PDF password here before parsing.</div>
                </div>
                <button class="btn btn-primary" type="button" id="parseServicePdfBtn">Parse PDF</button>
                <div id="servicePdfUploadMsg" class="alert mt-3 d-none" role="status"></div>

                <hr />
                <h3 class="h6">Manual capture / edit</h3>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="billingPeriodInput">Billing month</label>
                        <input type="month" class="form-control" id="billingPeriodInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="electricityAmountInput">Electricity amount</label>
                        <input type="number" step="0.01" class="form-control" id="electricityAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="waterAmountInput">Water amount</label>
                        <input type="number" step="0.01" class="form-control" id="waterAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="sewerageAmountInput">Sewerage amount</label>
                        <input type="number" step="0.01" class="form-control" id="sewerageAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="refuseAmountInput">Refuse amount</label>
                        <input type="number" step="0.01" class="form-control" id="refuseAmountInput" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label" for="servicesNotesInput">Notes</label>
                        <input type="text" class="form-control" id="servicesNotesInput" placeholder="Captured manually or from PDF" />
                    </div>
                </div>

                <hr />
                <h3 class="h6">Tax-only capture / edit</h3>
                <p class="small text-muted mb-2">These values are saved to the property tax ledger only and do not appear on the tenant statement.</p>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label" for="basicElectricityTaxAmountInput">Basic electricity</label>
                        <input type="number" step="0.01" class="form-control" id="basicElectricityTaxAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="basicWaterTaxAmountInput">Basic water</label>
                        <input type="number" step="0.01" class="form-control" id="basicWaterTaxAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="basicSewerageTaxAmountInput">Basic sewerage</label>
                        <input type="number" step="0.01" class="form-control" id="basicSewerageTaxAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="propertyRatesResidentialAmountInput">Property Rates Residential</label>
                        <input type="number" step="0.01" class="form-control" id="propertyRatesResidentialAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="propertyRatesRebate1AmountInput">PROPERTY RATES REBATE 1</label>
                        <input type="number" step="0.01" class="form-control" id="propertyRatesRebate1AmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="propertyRatesRebate2AmountInput">PROPERTY RATES REBATE 2</label>
                        <input type="number" step="0.01" class="form-control" id="propertyRatesRebate2AmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="propertyRatesResidentialRebateAmountInput">Property Rates Residential REBATE</label>
                        <input type="number" step="0.01" class="form-control" id="propertyRatesResidentialRebateAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="levyAmountInput">Levy</label>
                        <input type="number" step="0.01" class="form-control" id="levyAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="csosAmountInput">CSOS</label>
                        <input type="number" step="0.01" class="form-control" id="csosAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="hoaAmountInput">HOA</label>
                        <input type="number" step="0.01" class="form-control" id="hoaAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="levySecurityAmountInput">Levy Security Levy</label>
                        <input type="number" step="0.01" class="form-control" id="levySecurityAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="communalElectricityAmountInput">Communal electricity</label>
                        <input type="number" step="0.01" class="form-control" id="communalElectricityAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="communalWaterAmountInput">Communal water</label>
                        <input type="number" step="0.01" class="form-control" id="communalWaterAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="electricityDemandChargeAmountInput">Electricity demand charge</label>
                        <input type="number" step="0.01" class="form-control" id="electricityDemandChargeAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="electricitySurchargeAmountInput">Electricity surcharge</label>
                        <input type="number" step="0.01" class="form-control" id="electricitySurchargeAmountInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="electricityBasicChargeAmountInput">Electricity basic charge</label>
                        <input type="number" step="0.01" class="form-control" id="electricityBasicChargeAmountInput" />
                    </div>
                </div>
                <button class="btn btn-success mt-3" type="button" id="saveServicesBtn">Add services and tax entries</button>
                <div id="saveServicesMsg" class="alert mt-3 d-none"></div>

                <div id="servicePdfError" class="alert alert-danger mt-3 d-none"></div>

                <div id="servicePdfResults" class="mt-3 d-none">
                    <h3 class="h6">Electricity</h3>
                    <ul class="mb-3">
                        <li>Old reading: <strong id="electricityOldReading">-</strong></li>
                        <li>New reading: <strong id="electricityNewReading">-</strong></li>
                        <li>Levied amount: <strong id="electricityLeviedAmount">-</strong></li>
                    </ul>

                    <h3 class="h6">Water</h3>
                    <ul class="mb-3">
                        <li>Old reading: <strong id="waterOldReading">-</strong></li>
                        <li>New reading: <strong id="waterNewReading">-</strong></li>
                        <li>Levied amount: <strong id="waterLeviedAmount">-</strong></li>
                    </ul>

                    <h3 class="h6">Sewerage</h3>
                    <ul class="mb-3">
                        <li>Date: <strong id="sewerageDate">-</strong></li>
                        <li>Code: <strong id="sewerageCode">-</strong></li>
                        <li>Amount incl VAT: <strong id="sewerageAmount">-</strong></li>
                    </ul>

                    <h3 class="h6">Refuse</h3>
                    <ul class="mb-3">
                        <li>Date: <strong id="refuseDate">-</strong></li>
                        <li>Code: <strong id="refuseCode">-</strong></li>
                        <li>Amount incl VAT: <strong id="refuseAmount">-</strong></li>
                    </ul>



                    <h3 class="h6">Tax-only values</h3>
                    <ul class="mb-3">
                        <li>Basic electricity: <strong id="basicElectricityTaxAmount">-</strong></li>
                        <li>Basic water: <strong id="basicWaterTaxAmount">-</strong></li>
                        <li>Basic sewerage: <strong id="basicSewerageTaxAmount">-</strong></li>
                        <li>Property Rates Residential: <strong id="propertyRatesResidentialAmount">-</strong></li>
                        <li>PROPERTY RATES REBATE 1: <strong id="propertyRatesRebate1Amount">-</strong></li>
                        <li>PROPERTY RATES REBATE 2: <strong id="propertyRatesRebate2Amount">-</strong></li>
                        <li>Property Rates Residential REBATE: <strong id="propertyRatesResidentialRebateAmount">-</strong></li>
                        <li>Levy: <strong id="levyAmount">-</strong></li>
                        <li>CSOS: <strong id="csosAmount">-</strong></li>
                        <li>HOA: <strong id="hoaAmount">-</strong></li>
                        <li>Levy Security Levy: <strong id="levySecurityAmount">-</strong></li>
                        <li>Communal electricity: <strong id="communalElectricityAmount">-</strong></li>
                        <li>Communal water: <strong id="communalWaterAmount">-</strong></li>
                        <li>Electricity demand charge: <strong id="electricityDemandChargeAmount">-</strong></li>
                        <li>Electricity surcharge: <strong id="electricitySurchargeAmount">-</strong></li>
                        <li>Electricity basic charge: <strong id="electricityBasicChargeAmount">-</strong></li>
                    </ul>
                    <details>
                        <summary>Raw text preview</summary>
                        <pre id="servicePdfRawText" class="small mt-2 mb-0"></pre>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="addRentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Add rent</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Save the rent amount and effective month for the active lease.</p>
                <div class="mb-3">
                    <label class="form-label" for="rentEffectiveMonthInput">Effective month</label>
                    <input type="month" class="form-control" id="rentEffectiveMonthInput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rentAmountInput">Rent amount</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="rentAmountInput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rentNotesInput">Notes (optional)</label>
                    <input type="text" class="form-control" id="rentNotesInput" maxlength="400" />
                </div>
                <button class="btn btn-warning" type="button" id="saveRentBtn">Save rent</button>
                <div id="saveRentMsg" class="alert mt-3 d-none"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sendEmailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Preview statement email</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="sendTenantEmailMsg" class="alert mt-3 d-none"></div>

                <dl class="row mb-3 small">
                    <dt class="col-sm-2">To</dt>
                    <dd class="col-sm-10" id="previewEmailTo">-</dd>
                    <dt class="col-sm-2">Subject</dt>
                    <dd class="col-sm-10" id="previewEmailSubject">-</dd>
                </dl>

                <div class="mb-3">
                    <label class="form-label">Email body</label>
                    <div class="border rounded p-2 bg-light" id="previewEmailBody">-</div>
                </div>

                <h3 class="h6">Attached PDF preview</h3>
                <div id="previewStatementSummary" class="mb-3 text-muted small">-</div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Running Balance</th>
                            </tr>
                        </thead>
                        <tbody id="previewStatementTableBody"></tbody>
                    </table>
                </div>

                <button class="btn btn-primary" type="button" id="sendTenantEmailBtn">Send statement email</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="moreInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Any more info</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Store additional notes or special events for this property.</div></div></div>
</div>

<div class="modal fade" id="statementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Tenant Statement</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="statementMonthInput">Statement month</label>
                        <input type="month" class="form-control" id="statementMonthInput" />
                    </div>
                    <div class="col-md-3 align-self-end">
                        <button class="btn btn-outline-primary" type="button" id="reloadStatementBtn">Reload</button>
                    </div>
                    <div class="col-md-5 align-self-end text-md-end">
                        <button class="btn btn-primary" type="button" id="downloadStatementPdfBtn">Download professional PDF</button>
                    </div>
                </div>
                <div id="statementSummary" class="mb-3 text-muted"></div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Running Balance</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody id="statementTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const testGoogleDriveBtn = document.getElementById('testGoogleDriveBtn');
            const googleDriveTestMsg = document.getElementById('googleDriveTestMsg');
            const propertySelect = document.getElementById('propertySelect');
            const confirmButton = document.getElementById('confirmPropertyBtn');
            const selectedHeader = document.getElementById('selectedPropertyHeader');
            const statusCard = document.getElementById('propertyStatusCard');
            const statusDetails = document.getElementById('statusDetails');
            const actionSection = document.getElementById('propertyActionSection');
            const pickerElement = document.getElementById('propertyPickerModal');
            const statementButton = document.getElementById('viewStatementBtn');
            const statementSummary = document.getElementById('statementSummary');
            const statementTableBody = document.getElementById('statementTableBody');
            const statementMonthInput = document.getElementById('statementMonthInput');
            const reloadStatementBtn = document.getElementById('reloadStatementBtn');
            const downloadStatementPdfBtn = document.getElementById('downloadStatementPdfBtn');
            const switcherSection = document.getElementById('propertySwitcherSection');
            const switchPropertySelect = document.getElementById('propertySwitchSelect');
            const switchPropertyBtn = document.getElementById('switchPropertyBtn');
            const parseServicePdfBtn = document.getElementById('parseServicePdfBtn');
            const servicePdfFile = document.getElementById('servicePdfFile');
            const servicePdfPassword = document.getElementById('servicePdfPassword');
