            const renderRenterPaymentSummary = () => {
                if (!renterPaymentSummary) {
                    return;
                }

                if (!renterPaymentMatches.length) {
                    renterPaymentSummary.classList.add('d-none');
                    renterPaymentSummary.innerHTML = '';
                    return;
                }

                const rows = renterPaymentMatches.map(match => {
                    const paidTotal = (match.payments || []).reduce((total, payment) => total + Number(payment.amount || 0), 0);
                    const expectedAmount = match.expectedAmount === null || match.expectedAmount === undefined ? null : Number(match.expectedAmount);
                    const warning = expectedAmount !== null && paidTotal > expectedAmount
                        ? `Paid ${money(paidTotal)}, which is more than the expected ${money(expectedAmount)}. Check the amount before saving.`
                        : match.warning;
                    const rowClass = warning ? 'table-warning' : 'table-success';
                    return `
                        <tr class="${rowClass}">
                            <td>${match.propertyName}</td>
                            <td>${match.tenantName}</td>
                            <td><code>${match.paymentReference || '-'}</code></td>
                            <td class="text-end">${match.expectedAmount !== null && match.expectedAmount !== undefined ? Number(match.expectedAmount).toLocaleString(undefined, { style: 'currency', currency: 'ZAR' }) : '-'}</td>
                            <td class="text-end">${Number(paidTotal).toLocaleString(undefined, { style: 'currency', currency: 'ZAR' })}</td>
                            <td>${warning || 'Paid'}</td>
                        </tr>`;
                }).join('');

                renterPaymentSummary.innerHTML = `
                    <h4 class="h6">All renter payment check</h4>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Property</th><th>Renter</th><th>Reference</th><th class="text-end">Expected</th><th class="text-end">Paid</th><th>Status / warning</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
                renterPaymentSummary.classList.remove('d-none');
            };

            const renderPaymentRows = () => {
                if (!paymentTableBody) {
                    return;
                }

                paymentTableBody.innerHTML = parsedPayments.map((payment, index) => `
                    <tr>
                        <td><input class="form-control form-control-sm payment-date" data-index="${index}" type="date" value="${new Date(payment.paidOn).toISOString().slice(0, 10)}" /></td>
                        <td><input class="form-control form-control-sm payment-description" data-index="${index}" value="${payment.description}" /></td>
                        <td><input class="form-control form-control-sm payment-amount text-end" data-index="${index}" type="number" min="0" step="0.01" value="${payment.amount}" /></td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" data-index="${index}" type="button">Delete</button></td>
                    </tr>
                `).join('');

                renderRenterPaymentSummary();
            };

            paymentTableBody?.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement)) return;
                const index = Number(target.dataset.index);
                if (Number.isNaN(index) || !parsedPayments[index]) return;
                if (target.classList.contains('payment-date')) parsedPayments[index].paidOn = target.value;
                if (target.classList.contains('payment-description')) parsedPayments[index].description = target.value;
                if (target.classList.contains('payment-amount')) parsedPayments[index].amount = Number(target.value);
                renderPaymentRows();
            });

            paymentTableBody?.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }

                const deleteBtn = target.closest('button[data-index]');
                if (!deleteBtn) {
                    return;
                }

                const index = Number(deleteBtn.getAttribute('data-index'));
                if (Number.isNaN(index)) {
                    return;
                }

                const removed = parsedPayments.splice(index, 1)[0];
                renterPaymentMatches.forEach(match => {
                    match.payments = (match.payments || []).filter(payment => payment !== removed);
                    match.paidTotal = (match.payments || []).reduce((total, payment) => total + Number(payment.amount || 0), 0);
                });
                renderPaymentRows();
            });

