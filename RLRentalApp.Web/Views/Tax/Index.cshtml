@model RLRentalApp.Models.HomeIndexVm

@{
    ViewData["Title"] = "Tax";
}

<div class="container py-4 tax-dashboard">
    <h1 class="mb-3">Tax</h1>
    <p class="text-muted mb-4">Step one: capture tax money in/out rows and upload the proof document to Google Drive.</p>

    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Add expense / tax row</h2>
            <p class="text-muted">Use <strong>DEBIT</strong> for money out/expenses and <strong>KREDIT</strong> for money in. The proof can be an image, document, or PDF.</p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="taxPropertySelect">Property</label>
                    <select class="form-select" id="taxPropertySelect">
                        @foreach (var property in Model.Properties)
                        {
                            <option value="@property.Id">@property.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="taxDateInput">Date</label>
                    <input class="form-control" type="date" id="taxDateInput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="taxKindSelect">Kredit / Debit</label>
                    <select class="form-select" id="taxKindSelect">
                        <option value="DEBIT">DEBIT - money out</option>
                        <option value="KREDIT">KREDIT - money in</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="taxAmountInput">Amount</label>
                    <input class="form-control" type="number" min="0" step="0.01" id="taxAmountInput" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="taxDescriptionInput">Description</label>
                    <input class="form-control" type="text" id="taxDescriptionInput" maxlength="300" placeholder="Example: Plumbing repair, insurance, rental income" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="taxProofFileInput">Proof file</label>
                    <input class="form-control" type="file" id="taxProofFileInput" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
                </div>
                <div class="col-12">
                    <button class="btn btn-success" type="button" id="saveTaxTransactionBtn">Save tax row and upload proof</button>
                    <div id="taxSaveMsg" class="alert mt-3 d-none"></div>
                </div>
            </div>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">Tax table</h2>
                    <p class="text-muted mb-0">Each row links back to its proof in Google Drive.</p>
                </div>
                <div class="d-flex align-items-end gap-2">
                    <div>
                        <label class="form-label" for="taxYearInput">Year</label>
                        <input class="form-control" type="number" id="taxYearInput" min="2000" max="2100" />
                    </div>
                    <button class="btn btn-outline-primary" type="button" id="loadTaxRowsBtn">Reload</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Property</th>
                            <th>Description</th>
                            <th class="text-end">KREDIT</th>
                            <th class="text-end">DEBIT</th>
                            <th>Proof</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="taxRowsTableBody"></tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="3">Total</td>
                            <td class="text-end" id="taxTotalKredit">-</td>
                            <td class="text-end" id="taxTotalDebit">-</td>
                            <td id="taxNetTotal">-</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const taxPropertySelect = document.getElementById('taxPropertySelect');
            const taxDateInput = document.getElementById('taxDateInput');
            const taxKindSelect = document.getElementById('taxKindSelect');
            const taxAmountInput = document.getElementById('taxAmountInput');
            const taxDescriptionInput = document.getElementById('taxDescriptionInput');
            const taxProofFileInput = document.getElementById('taxProofFileInput');
            const saveTaxTransactionBtn = document.getElementById('saveTaxTransactionBtn');
            const taxSaveMsg = document.getElementById('taxSaveMsg');
            const taxYearInput = document.getElementById('taxYearInput');
            const loadTaxRowsBtn = document.getElementById('loadTaxRowsBtn');
            const taxRowsTableBody = document.getElementById('taxRowsTableBody');
            const taxTotalKredit = document.getElementById('taxTotalKredit');
            const taxTotalDebit = document.getElementById('taxTotalDebit');
            const taxNetTotal = document.getElementById('taxNetTotal');

            const money = value => value !== null && value !== undefined
                ? Number(value).toLocaleString(undefined, { style: 'currency', currency: 'ZAR' })
                : '-';

            const today = new Date();
            taxDateInput.value = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
            taxYearInput.value = today.getFullYear();

            const renderTaxRows = async () => {
                const response = await fetch(`/Tax/Transactions?year=${taxYearInput.value}`);
                if (!response.ok) {
                    taxRowsTableBody.innerHTML = '<tr><td colspan="7" class="text-danger">Could not load tax rows.</td></tr>';
                    return;
                }

                const payload = await response.json();
                taxRowsTableBody.innerHTML = (payload.transactions || []).map(row => `
                    <tr>
                        <td>${new Date(row.transactionDate).toLocaleDateString()}</td>
                        <td>${row.propertyName}</td>
                        <td>${row.description}</td>
                        <td class="text-end">${row.entryKind === 'KREDIT' ? money(row.amount) : '-'}</td>
                        <td class="text-end">${row.entryKind === 'DEBIT' ? money(row.amount) : '-'}</td>
                        <td><a href="${row.proofDriveLink}" target="_blank" rel="noopener">${row.proofFileName || 'Open proof'}</a></td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-delete-tax-id="${row.id}">Delete test row</button></td>
                    </tr>
                `).join('');
                taxTotalKredit.textContent = money(payload.totalKredit);
                taxTotalDebit.textContent = money(payload.totalDebit);
                taxNetTotal.textContent = `Net: ${money(payload.net)}`;
            };

            saveTaxTransactionBtn.addEventListener('click', async () => {
                taxSaveMsg.classList.add('d-none');
                const formData = new FormData();
                formData.append('propertyId', taxPropertySelect.value || '');
                formData.append('transactionDate', taxDateInput.value || '');
                formData.append('entryKind', taxKindSelect.value || 'DEBIT');
                formData.append('amount', taxAmountInput.value || '');
                formData.append('description', taxDescriptionInput.value || '');
                if (taxProofFileInput.files?.[0]) formData.append('proofFile', taxProofFileInput.files[0]);

                const response = await fetch('/Tax/SaveTransaction', { method: 'POST', body: formData });
                const payload = await response.json();
                taxSaveMsg.className = response.ok ? 'alert alert-success mt-3' : 'alert alert-danger mt-3';
                taxSaveMsg.textContent = payload.message || (response.ok ? 'Saved.' : 'Could not save tax row.');
                taxSaveMsg.classList.remove('d-none');

                if (response.ok) {
                    taxAmountInput.value = '';
                    taxDescriptionInput.value = '';
                    taxProofFileInput.value = '';
                    await renderTaxRows();
                }
            });


            taxRowsTableBody.addEventListener('click', async (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }

                const deleteButton = target.closest('button[data-delete-tax-id]');
                if (!deleteButton) {
                    return;
                }

                const taxTransactionId = deleteButton.getAttribute('data-delete-tax-id');
                if (!taxTransactionId || !confirm('Delete this tax row and its proof file from Google Drive?')) {
                    return;
                }

                const formData = new FormData();
                formData.append('taxTransactionId', taxTransactionId);
                formData.append('deleteProofFile', 'true');

                const response = await fetch('/Tax/DeleteTransaction', { method: 'POST', body: formData });
                const payload = await response.json();
                taxSaveMsg.className = response.ok ? 'alert alert-success mt-3' : 'alert alert-danger mt-3';
                taxSaveMsg.textContent = payload.message || (response.ok ? 'Deleted.' : 'Could not delete tax row.');
                taxSaveMsg.classList.remove('d-none');

                if (response.ok) {
                    await renderTaxRows();
                }
            });

            loadTaxRowsBtn.addEventListener('click', renderTaxRows);
            renderTaxRows();
        })();
    </script>
}
